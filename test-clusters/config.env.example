# Parameters of the test-cluster scripts. Copy this file to config.env, which
# git ignores, and set your values. settings.sh describes every parameter.
REGION=us-east-1
# A subnet with a route to the internet, for every node.
SUBNET_ID=subnet-0123456789abcdef0
# The tag or branch to test, and the repository to install it from.
REF=main
REPO=aws-samples/aws-parallelcluster-monitoring
# Optional:
# PREFIX=monitoring-test
# KEY_NAME=my-key-pair
# FSX_ID=fs-0123456789abcdef0
# SLURM_VERSION=26.05
# TAGS=owner=me,purpose=monitoring-test
